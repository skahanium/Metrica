# Normalize text files on checkout; keeps Julia/Rust sources LF across OS.
* text=auto

*.jl   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.rs   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf

# Windows scripts stay CRLF when checked out on Windows
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
