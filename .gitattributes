# 检出时规范化文本换行；跨操作系统保持 Julia/Rust 等源码为 LF。
* text=auto

*.jl   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.rs   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.csv  text eol=lf
*.sh   text eol=lf

# Windows 脚本在 Windows 检出时保持 CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
