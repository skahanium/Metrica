{
  "name": "metrica-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:runtime": "cargo build --release --manifest-path ../../runtime/metrica-runtime/Cargo.toml",
    "build:desktop": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "build:all": "npm run build && npm run build:runtime && npm run build:desktop",
    "preview": "vite preview",
    "start": "node scripts/launch.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "antd": "^5.22.0",
    "@ant-design/icons": "^5.5.0",
    "ag-grid-community": "^33.0.0",
    "ag-grid-react": "^33.0.0",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
